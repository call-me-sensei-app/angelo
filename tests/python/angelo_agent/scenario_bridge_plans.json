    "python": {
     "description": "Delete only the default Cube, Camera and Light; build a watertight 120 × 80 m Valley block with a flat -8 m base, shaped river banks and a grass/earth material. No files or external access.",
     "code": "import bpy, math, bmesh\nfrom mathutils import Vector\nscene = bpy.context.scene\nfor name, typ in [('Cube','MESH'),('Camera','CAMERA'),('Light','LIGHT')]:\n    obj = scene.objects.get(name)\n    if obj is None or obj.type != typ:\n        raise RuntimeError('Default object changed: '+name)\nif scene.objects.get('Valley'):\n    raise RuntimeError('Valley already exists')\ndef smooth(t):\n    t=max(0.0,min(1.0,t)); return t*t*(3-2*t)\ndef height(x,y):\n    a=abs(x)\n    if a<=5: return -4.0\n    if a<9: return -4+4*smooth((a-5)/4)\n    rise=smooth((a-14)/46)\n    wave=0.79+0.13*math.sin(y/19+x/27)+0.08*math.cos(y/11-x/23)\n    return 5*rise*wave\nnx,ny=241,81\nverts=[(-60+i*0.5,-40+j,height(-60+i*0.5,-40+j)) for j in range(ny) for i in range(nx)]\nfaces=[]\nfor j in range(ny-1):\n    for i in range(nx-1):\n        k=j*nx+i; faces.append((k,k+1,k+1+nx,k+nx))\ntop_count=len(faces)\nperimeter=list(range(nx))+[j*nx+nx-1 for j in range(1,ny)]+[(ny-1)*nx+i for i in range(nx-2,-1,-1)]+[j*nx for j in range(ny-2,0,-1)]\nbase_start=len(verts)\nverts.extend([(verts[k][0],verts[k][1],-8.0) for k in perimeter])\nfor t,k in enumerate(perimeter):\n    u=(t+1)%len(perimeter)\n    faces.append((k,base_start+t,base_start+u,perimeter[u]))\nfaces.append(tuple(base_start+t for t in reversed(range(len(perimeter)))))\nmesh=bpy.data.meshes.new('Valley Solid Terrain')\nmesh.from_pydata(verts,[],faces); mesh.update()\nobj=bpy.data.objects.new('Valley',mesh); scene.collection.objects.link(obj)\ncolors=mesh.color_attributes.new(name='GrassEarth',type='FLOAT_COLOR',domain='CORNER')\nearth=(0.27,0.125,0.048); grass=(0.19,0.235,0.055)\nfor p in mesh.polygons:\n    is_top=p.index<top_count\n    p.use_smooth=is_top\n    for li in p.loop_indices:\n        v=mesh.vertices[mesh.loops[li].vertex_index].co\n        blend=smooth((abs(v.x)-7.2)/1.8) if is_top else 0.0\n        variation=1+0.035*math.sin(v.x*0.33+v.y*0.17)*math.cos(v.y*0.29)\n        colors.data[li].color=tuple((earth[c]*(1-blend)+grass[c]*blend)*variation for c in range(3))+(1.0,)\nmat=bpy.data.materials.new('Valley Grass and Earth'); mat.use_nodes=True\nmat.diffuse_color=(*grass,1)\nnodes=mat.node_tree.nodes; links=mat.node_tree.links\nbsdf=nodes.get('Principled BSDF'); bsdf.inputs['Roughness'].default_value=0.88\nvc=nodes.new('ShaderNodeVertexColor'); vc.layer_name='GrassEarth'; vc.location=(-300,100)\nlinks.new(vc.outputs['Color'],bsdf.inputs['Base Color'])\nobj.data.materials.append(mat)\nbm=bmesh.new(); bm.from_mesh(mesh)\nnonmanifold=sum(not e.is_manifold for e in bm.edges)\nvolume=bm.calc_volume(signed=True); bm.free()\nif nonmanifold or volume<=0:\n    raise RuntimeError('Terrain validation failed')\nfor name in ['Cube','Camera','Light']:\n    bpy.data.objects.remove(scene.objects[name],do_unlink=True)\nscene.unit_settings.system='METRIC'; scene.unit_settings.scale_length=1\nfor other in bpy.context.selected_objects: other.select_set(False)\nobj.select_set(True); bpy.context.view_layer.objects.active=obj\nbpy.context.view_layer.update()\nresult={'created':obj.name,'deleted':['Cube','Camera','Light'],'dimensions':list(obj.dimensions),'base_z':min(v.co.z for v in mesh.vertices),'riverbed_z':sorted(set(round(v.co.z,5) for v in mesh.vertices[:nx*ny] if abs(v.co.x)<=5)),'bank_z_at_9':sorted(set(round(v.co.z,5) for v in mesh.vertices[:nx*ny] if abs(v.co.x)==9)),'nonmanifold_edges':nonmanifold,'volume':volume,'vertices':len(mesh.vertices),'faces':len(mesh.polygons),'material':mat.name}\n"
