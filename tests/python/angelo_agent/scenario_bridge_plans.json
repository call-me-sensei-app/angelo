    "python": {
     "description": "Build the specified stone deck, closed elliptical arch ring, six curve-fitted pier walls, and two abutments. Create only Bridge-prefixed objects; preserve Valley.",
     "code": "import bpy, math, bmesh\nscene=bpy.context.scene\nnames=['Bridge Deck','Bridge Arch','Bridge Piers','Bridge Abutments']\nif any(scene.objects.get(n) for n in names):\n    raise RuntimeError('A requested bridge part already exists')\nmat=bpy.data.materials.new('Bridge Warm Grey Stone'); mat.use_nodes=True\nmat.diffuse_color=(0.43,0.395,0.34,1)\nbsdf=mat.node_tree.nodes.get('Principled BSDF')\nbsdf.inputs['Base Color'].default_value=mat.diffuse_color\nbsdf.inputs['Roughness'].default_value=0.82\ncreated=[]\ndef make(name,verts,faces,smooth_faces=()):\n    mesh=bpy.data.meshes.new(name+' Mesh'); mesh.from_pydata(verts,[],faces); mesh.update()\n    bm=bmesh.new(); bm.from_mesh(mesh); bmesh.ops.recalc_face_normals(bm,faces=list(bm.faces)); bm.to_mesh(mesh)\n    bad=sum(not e.is_manifold for e in bm.edges); volume=bm.calc_volume(); bm.free()\n    if bad or volume<=0: raise RuntimeError(name+' failed solid validation')\n    obj=bpy.data.objects.new(name,mesh); scene.collection.objects.link(obj); mesh.materials.append(mat)\n    for i in smooth_faces: mesh.polygons[i].use_smooth=True\n    created.append((obj,bad,volume)); return obj\nbox_faces=[(0,3,2,1),(4,5,6,7),(0,1,5,4),(1,2,6,5),(2,3,7,6),(3,0,4,7)]\ndef box(v,f,x0,x1,y0,y1,z0,z1):\n    k=len(v); v.extend([(x0,y0,z0),(x1,y0,z0),(x1,y1,z0),(x0,y1,z0),(x0,y0,z1),(x1,y0,z1),(x1,y1,z1),(x0,y1,z1)])\n    f.extend([tuple(k+i for i in face) for face in box_faces])\nv=[];f=[];box(v,f,-12,12,-2.5,2.5,0.4,1);make('Bridge Deck',v,f)\nn=160;v=[];f=[];sm=[]\nfor i in range(n+1):\n    t=math.pi*i/n\n    xo=8*math.cos(t); zo=-2.5+2.9*math.sin(t)\n    xi=7.2*math.cos(t); zi=-2.5+2.1*math.sin(t)\n    v.extend([(xo,-2.2,zo),(xo,2.2,zo),(xi,-2.2,zi),(xi,2.2,zi)])\nfor i in range(n):\n    k=4*i;l=k+4\n    sm.extend([len(f),len(f)+1])\n    f.extend([(k,l,l+1,k+1),(k+2,k+3,l+3,l+2),(k,k+2,l+2,l),(k+1,l+1,l+3,k+3)])\nf.extend([(0,1,3,2),(4*n,4*n+2,4*n+3,4*n+1)])\nmake('Bridge Arch',v,f,sm)\ndef arch_z(x):\n    t=math.acos(x/8); q=t/math.pi*n; i=min(n-1,int(q)); a=math.pi*i/n; b=math.pi*(i+1)/n\n    xa=8*math.cos(a); xb=8*math.cos(b)\n    u=(x-xa)/(xb-xa)\n    return -2.5+2.9*((1-u)*math.sin(a)+u*math.sin(b))\nv=[];f=[]\nfor center in [-7,-5.5,-4,4,5.5,7]:\n    x0=center-0.25;x1=center+0.25\n    xs=sorted([x0,x1]+[8*math.cos(math.pi*i/n) for i in range(n+1) if x0<8*math.cos(math.pi*i/n)<x1])\n    start=len(v)\n    for x in xs: v.extend([(x,-2.2,arch_z(x)),(x,2.2,arch_z(x)),(x,-2.2,0.4),(x,2.2,0.4)])\n    for j in range(len(xs)-1):\n        k=start+4*j;l=k+4\n        f.extend([(k,k+1,l+1,l),(k+2,l+2,l+3,k+3),(k,l,l+2,k+2),(k+1,k+3,l+3,l+1)])\n    k=start+4*(len(xs)-1)\n    f.extend([(start,start+2,start+3,start+1),(k,k+1,k+3,k+2)])\nmake('Bridge Piers',v,f)\nv=[];f=[]\nfor x0,x1 in [(-12,-9),(9,12)]: box(v,f,x0,x1,-2.2,2.2,-1,0.4)\nmake('Bridge Abutments',v,f)\nbpy.context.view_layer.update()\nresult={'parts':[{'name':o.name,'dimensions':list(o.dimensions),'nonmanifold_edges':bad,'volume':vol} for o,bad,vol in created],'arch_outer':{'span':16,'spring_z':-2.5,'crown_z':0.4},'arch_inner':{'span':14.4,'crown_z':-0.4},'piers_centers':[-7,-5.5,-4,4,5.5,7],'pier_thickness':0.5,'material':mat.name}\n"
