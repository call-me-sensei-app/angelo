{
  "rule": "Fixed 2026-11-04 before any download. Every .glb directly in the model folder of each Kenney 3D starter kit on GitHub other than the 3D Platformer (Starter-Kit-Match-3 has no 3D models), and every .glb of KayKit Character Pack Skeletons 1.0 (skinned, animated characters), each pinned to the commit below. No file is dropped by name, size or content; .gltf+.bin files are outside the rule because the driver imports .glb. Local names get a per-kit prefix because names collide across kits.",
  "excluded": "Kenney Starter Kit 3D Platformer (it may have been seen while the feature was developed; the feature's own development tests build their scenes in code). KayKit Adventurers, Dungeon Remastered and Furniture Bits and the Poly Haven models are held-out sets of other features and were passed over to keep this set fresh.",
  "sources": [
    {
      "kit": "Kenney Starter Kit Racing",
      "repo": "KenneyNL/Starter-Kit-Racing",
      "commit": "2f2e5f2646dda89cb21d4e8539bab60c6e955dc8",
      "glob": "models/*.glb",
      "prefix": "racing-",
      "licence": "CC0-1.0 (models); the kit's Godot project code is MIT (LICENSE)",
      "licence_file": "README.md",
      "licence_statement": "3D Models & sounds _(CC0 licensed)_",
      "licence_url": "https://raw.githubusercontent.com/KenneyNL/Starter-Kit-Racing/2f2e5f2646dda89cb21d4e8539bab60c6e955dc8/README.md",
