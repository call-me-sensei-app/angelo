msgstr "Un ponte di pietra al crepuscolo"

#. src: angelo_agent/controller.py
msgid "A stronger model on this connection, {model}, may handle this request better ({reason}). Choose it in the model picker to retry; nothing is retried automatically."
msgstr "Un modello più potente su questa connessione, {model}, potrebbe gestire meglio questa richiesta ({reason}). Sceglilo nel selettore dei modelli per riprovare; nulla viene ritentato automaticamente."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "A team library: search your team's shared media and worlds, bring assets into a scene and save models back."
msgstr "Una libreria del team: cerca i media e i mondi condivisi dal team, porta le risorse in una scena e salva i modelli nella libreria."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "A welcome screen on first launch shows the two ways to work, Director and the standard editor, and how to switch. Open it again from the Help menu."
msgstr "Al primo avvio, una schermata di benvenuto mostra i due modi di lavorare, Regista e l'editor standard, e come passare dall'uno all'altro. Puoi riaprirla dal menu Aiuto."

