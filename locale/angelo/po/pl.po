msgstr "Połączenie zostało usunięte. Spróbuj ponownie."

#. src: angelo_agent/team_errors.py
msgid "The console didn't accept this sign-in (it may have taken longer than a minute). Choose Sign in to try again."
msgstr "Konsola nie zaakceptowała tego logowania (mogło trwać dłużej niż minutę). Wybierz Zaloguj się, aby spróbować ponownie."

#. src: angelo_agent/team_errors.py
msgid "The console refused the sign-in; choose Sign in to try again."
msgstr "Konsola odrzuciła logowanie; wybierz Zaloguj się, aby spróbować ponownie."

#. src: angelo_agent/crash_card.py
