msgstr "Komputery zalogowane na twoje konto; możesz wylogować dowolny z nich"

#. src: angelo_agent/team_errors.py
msgid "The connection dropped while renewing your Angelo sign-in. Sign in to your Angelo team again in Preferences > AI Providers."
msgstr "Połączenie zostało przerwane podczas odnawiania logowania do Angelo. Zaloguj się ponownie do zespołu Angelo w Preferencje > Dostawcy AI."

#. src: angelo_agent/providers_sheet.py
