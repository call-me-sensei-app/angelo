msgstr "रखा गया पूर्वावलोकन अब उपलब्ध नहीं है"

#. src: angelo_agent/ui.py
msgid "The saved connection is unavailable. Open AI Providers to choose a connection."
msgstr "सहेजा गया कनेक्शन उपलब्ध नहीं है। कनेक्शन चुनने के लिए AI प्रदाता खोलें।"

#. src: angelo_agent/activity_text.py
msgid "The scene changed while Angelo was working"
msgstr "Angelo के काम करते समय दृश्य बदल गया"

#. :src: scripts/addons_core/angelo_agent/web_preview.py
#. src: angelo_agent/web_preview.py
msgid "The scene has nothing the web can show yet"
msgstr "दृश्य में अभी ऐसा कुछ नहीं है जो वेब दिखा सके"

#. :src: scripts/addons_core/angelo_agent/web_export_ui.py
#. src: angelo_agent/web_export_ui.py
msgid "The scene in your browser as Three.js draws it, updated as you work"
msgstr "आपके ब्राउज़र में दृश्य जैसा Three.js उसे बनाता है, आपके काम के साथ अपडेट होता हुआ"

#. src: angelo_agent/job_chat.py
msgid "the scene is set to render on the CPU"
msgstr "दृश्य CPU पर रेंडर करने के लिए सेट है"

#. src: angelo_agent/checkpoint_restore_ui.py
msgid "The scene opened but recovery is incomplete"
msgstr "दृश्य खुल गया, लेकिन पुनर्प्राप्ति अधूरी है"

#. src: angelo_agent/checkpoint_restore_ui.py
msgid "The scene was restored, but recovery is incomplete. Inspect this chat and Undo restore; safety snapshot {snapshot}"
msgstr "दृश्य पुनर्स्थापित किया गया, लेकिन पुनर्प्राप्ति अधूरी है। इस चैट और “पुनर्स्थापना पूर्ववत् करें” की जाँच करें; सुरक्षा स्नैपशॉट {snapshot}"

#. src: angelo_agent/job_runners.py
msgid "The scene's frame step or output format changed since this render was approved, so it would write other frames or files; start it again"
msgstr "इस प्रतिपादन की मंज़ूरी के बाद दृश्य का गठन चरण या आउटपुट प्रारूप बदल गया, इसलिए यह दूसरे गठन या संचिकाएँ लिखेगा; इसे फिर से शुरू करें"

#. src: angelo_agent/job_approvals.py
msgid "The scene's own image settings: {settings}"
msgstr "दृश्य की अपनी छवि सेटिंग्स: {settings}"

#. src: angelo_agent/job_runners.py
msgid "The scene's views or File Output nodes changed since this render was approved, so it would write other files; start it again"
msgstr "इस प्रतिपादन की मंज़ूरी के बाद दृश्य के व्यू या फ़ाइल आउटपुट ग्रन्थियाँ बदल गईं, इसलिए यह दूसरी संचिकाएँ लिखेगा; इसे फिर से शुरू करें"

#. src: angelo_agent/job_recovery.py
#. src: angelo_agent/job_resume.py
msgid "The scene's views or File Output nodes changed since this render, so the rest would not match its frames; start a new render"
msgstr "इस प्रतिपादन के बाद दृश्य के व्यू या फ़ाइल आउटपुट ग्रन्थियाँ बदल गईं, इसलिए बाकी हिस्सा इसके गठनों से मेल नहीं खाएगा; नया प्रतिपादन शुरू करें"

#. src: angelo_agent/job_runners.py
msgid "The scenes the Sequencer renders changed since this render was approved; start it again"
msgstr "इस प्रतिपादन की मंज़ूरी के बाद सीक्वेंसर द्वारा प्रतिपादित दृश्य बदल गए; इसे फिर से शुरू करें"

#. src: angelo_agent/activity_text.py
msgid "The script asked for something that doesn't exist"
msgstr "स्क्रिप्ट ने ऐसी चीज़ माँगी जो मौजूद नहीं है"

#. src: angelo_agent/activity_text.py
msgid "The script divided by zero"
msgstr "स्क्रिप्ट ने शून्य से भाग दिया"

#. src: angelo_agent/activity_text.py
msgid "The script had a typing mistake"
msgstr "स्क्रिप्ट में टाइपिंग की गलती थी"

#. src: angelo_agent/activity_text.py
msgid "The script hit a problem partway through"
msgstr "स्क्रिप्ट बीच में किसी समस्या में फँस गई"

#. src: angelo_agent/activity_text.py
msgid "The script hit a problem, so your scene was put back"
msgstr "स्क्रिप्ट में समस्या आई, इसलिए आपका दृश्य पहले जैसा कर दिया गया"

#. src: angelo_agent/activity_text.py
msgid "The script passed the wrong kind of value"
msgstr "स्क्रिप्ट ने गलत प्रकार का मान दिया"

#. src: angelo_agent/activity_text.py
msgid "The script reached past the end of a list"
msgstr "स्क्रिप्ट सूची के अंत से आगे चली गई"

#. src: angelo_agent/script_errors.py
msgid ""
"The script stopped with an error. Scene data was restored, but image pixels and external effects were not verified:\n"
"{error}"
msgstr ""
"स्क्रिप्ट एक त्रुटि के साथ रुक गई। दृश्य डेटा बहाल कर दिया गया, लेकिन छवि के पिक्सेल और बाहरी प्रभावों की पुष्टि नहीं की गई:\n"
"{error}"

#. src: angelo_agent/script_errors.py
msgid ""
"The script stopped with an error. Some changes may remain; inspect the scene before continuing:\n"
"{error}"
msgstr ""
"स्क्रिप्ट एक त्रुटि के साथ रुक गई। कुछ बदलाव रह सकते हैं; जारी रखने से पहले दृश्य की जाँच करें:\n"
"{error}"

#. src: angelo_agent/activity_text.py
msgid "The script used a name it never defined"
msgstr "स्क्रिप्ट ने एक अपरिभाषित नाम इस्तेमाल किया"

#. src: angelo_agent/activity_text.py
msgid "The script used a setting Angelo doesn't have"
msgstr "स्क्रिप्ट ने ऐसी सेटिंग इस्तेमाल की जो Angelo में नहीं है"

#. src: angelo_agent/activity_text.py
msgid "The script used a value Angelo can't accept"
msgstr "स्क्रिप्ट ने ऐसा मान दिया जो Angelo नहीं लेता"

#. src: angelo_agent/self_checks.py
msgid ""
"The script's self-checks still fail:\n"
"{failures}"
msgstr ""
"स्क्रिप्ट की स्व-जाँचें अब भी विफल हैं:\n"
"{failures}"

#. src: angelo_agent/studio.py
#. src: angelo_agent/studio_ops.py
msgid "The selected enhancer connection is missing. Open AI Providers."
msgstr "चुना गया संवर्धक कनेक्शन नहीं मिला। AI प्रदाता खोलें।"

#. src: angelo_agent/job_approvals.py
msgid "The Sequencer also renders {scenes} with their own render settings"
msgstr "सीक्वेंसर {scenes} को भी उनकी अपनी प्रतिपादन सेटिंग्स के साथ प्रतिपादित करता है"

#. src: angelo_agent/crash_card.py
msgid "The server did not accept this report. You can save it and attach it when you report the problem."
msgstr "सर्वर ने यह रिपोर्ट स्वीकार नहीं की। आप इसे सहेजकर समस्या की रिपोर्ट करते समय संलग्न कर सकते हैं।"

#. src: angelo_agent/parallel_setting.py
#. src: bpy.types.ANGELO_Preferences.rail_minimized
msgid "The Sessions panel shows as a round button at the top right of the 3D view"
