#. src: bpy.types.ANGELO_GenerationFlowTree.angelo_recipe_output
msgid "The step whose chosen output this flow passes on when it runs as a Subflow; empty when it has no output"
msgstr "वह चरण जिसका चुना हुआ आउटपुट यह फ़्लो सबफ़्लो के रूप में चलने पर आगे देता है; आउटपुट न हो तो खाली"

#. src: angelo_agent/ui.py
msgid "The target chat is no longer ready for attachments"
msgstr "लक्ष्य चैट अब अनुलग्नकों के लिए तैयार नहीं है"

#. src: angelo_agent/team_errors.py
msgid "The team account hit an unexpected error; try again."
msgstr "टीम खाते में एक अप्रत्याशित त्रुटि हुई; फिर से प्रयास करें।"

#. src: source/blender/makesrna/intern/rna_render.cc
msgid "The temp directory used by Angelo"
msgstr "Angelo द्वारा उपयोग की जाने वाली अस्थायी निर्देशिका"

#. src: angelo_agent/update_restart.py
