msgstr "O quadro da câmera não foi renderizado; o cartão dele no chat explica o motivo"

#. src: angelo_agent/studio_video_ui.py
msgid "The camera's view couldn't be rendered"
msgstr "Não foi possível renderizar a visão da câmera"

#. src: bpy.types.AngeloPhysicsSettings.height
