msgstr "O GLB usa arquivos externos. Exporte um GLB autocontido antes de importá-lo no Angelo"

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The Restore confirmation is two short paragraphs."
msgstr "A confirmação de restauração tem dois parágrafos curtos."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
