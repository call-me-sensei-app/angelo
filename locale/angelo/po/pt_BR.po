msgstr "O Angelo não conseguiu fazer o que o script pediu"

#. src: angelo_agent/web_preview.py
msgid "Angelo couldn't draw its viewport: {reason}"
msgstr "O Angelo não conseguiu desenhar a janela de exibição: {reason}"

#. src: angelo_agent/activity_text.py
msgid "Angelo couldn't find that object"
msgstr "O Angelo não encontrou esse objeto"

#. src: angelo_agent/activity_text.py
msgid "Angelo couldn't find what it needed"
msgstr "O Angelo não encontrou o que precisava"

#. src: angelo_agent/team_pages.py
