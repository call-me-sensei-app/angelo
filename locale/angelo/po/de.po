msgstr "Der Chat ist ausgeblendet"

#. src: angelo_agent/worker_reasons.py
msgid "the chat is not open in its worker"
msgstr "der Chat ist in seinem Worker nicht geöffnet"

#. src: angelo_agent/worker_reasons.py
