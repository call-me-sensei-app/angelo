msgstr "der Chat oder sein Teil hat sich zuvor geändert"

#. src: angelo_agent/worker_reasons.py
msgid "the chat's turn had already ended"
msgstr "die Runde des Chats war bereits beendet"

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The chat's welcome cards sit in the middle of the chat."
msgstr "Die Willkommenskarten des Chats stehen in der Mitte des Chats."

