msgid "{action} · expired, nothing ran"
msgstr "{action} · หมด​เวลา ไม่มี​อะไร​ทำงาน"

msgid "{action} · failed"
msgstr "{action} · ล้มเหลว"

msgid "{action} · needs usage approval"
msgstr "{action} · ต้องการอนุมัติการใช้งาน"

