msgstr "Bản xem trước do Angelo dựng trong cuộc trò chuyện này."

msgid "The preview changed while you were reviewing it. Open it again"
msgstr "Bản xem trước đã thay đổi trong lúc bạn xem xét. Hãy mở lại"

msgid "The preview could not be applied; nothing changed"
msgstr "Không thể áp dụng bản xem trước; không có gì thay đổi"

msgid "The web export didn't finish. {reason}"
msgstr "Xuất web chưa hoàn tất. {reason}"

msgid "The window now shows another scene or file; '{label}' continues in chat {identity}. This transcript stays readable."
msgstr "Cửa sổ hiện hiển thị cảnh hoặc tệp khác; '{label}' tiếp tục trong cuộc trò chuyện {identity}. Bạn vẫn đọc được bản ghi này."

msgid "These are notes only. Confirming them changes nothing in your scene."
msgstr "Đây chỉ là ghi chú. Xác nhận không thay đổi gì trong cảnh."

msgid "These notes belong to this project"
msgstr "Các ghi chú này thuộc dự án này"

msgid "These snapshots can't be restored after removal. Your scene and Undo are unchanged."
msgstr "Không thể khôi phục các bản chụp nhanh này sau khi gỡ. Cảnh và lịch sử hoàn tác không đổi."

msgid "These timings never include your prompts, code or keys, and stay on this computer."
msgstr "Các số đo này không bao giờ chứa lời nhắc, mã hoặc khóa của bạn và chỉ lưu trên máy tính này."

#. src: angelo_agent/fab_ui.py
msgid "This Fab choice expired. Search and choose it again."
msgstr "Lựa chọn Fab này đã hết hạn. Hãy tìm kiếm và chọn lại."

msgid "This PDF has no text to read; it may be scanned. Attach pictures of its pages instead."
msgstr "PDF này không có văn bản để đọc; có thể là bản quét. Hãy đính kèm ảnh các trang."

msgid "This PDF is locked or protected, so its text can't be read. Attach an unlocked copy or pictures of its pages instead."
msgstr "PDF này bị khóa hoặc bảo vệ nên không đọc được văn bản. Hãy đính kèm bản không khóa hoặc ảnh các trang."

msgid "This PDF's text can't be read because Angelo's PDF reader is missing. Reinstall Angelo, or attach pictures of its pages instead."
msgstr "Không đọc được văn bản PDF này vì thiếu trình đọc PDF của Angelo. Cài lại Angelo hoặc đính kèm ảnh các trang."

msgid "This applies only to this chat while the file stays open; restarting Angelo turns it off."
msgstr "Chỉ áp dụng cho cuộc trò chuyện này khi tệp còn mở; khởi động lại Angelo sẽ tắt."

msgid "This approval has expired. Nothing changed"
msgstr "Lượt phê duyệt này đã hết hạn. Không có gì thay đổi"

#. src: angelo_agent/fab_ui.py
msgid "This asset requires a purchase on Fab before it can be added."
msgstr "Bạn phải mua tài sản này trên Fab trước khi có thể thêm."

msgid "This background job couldn't be stopped. It may have ended already."
msgstr "Không dừng được tác vụ nền này. Có thể tác vụ đã kết thúc."

msgid "This build can't apply them in Sculpt Mode. Leave Sculpt Mode first"
msgstr "Bản dựng này không thể áp dụng trong Chế độ Điêu khắc. Hãy thoát Chế độ Điêu khắc trước"

msgid "This chat belongs to another file. Start a new chat to work on this one."
msgstr "Cuộc trò chuyện này thuộc tệp khác. Bắt đầu cuộc trò chuyện mới để làm việc với tệp này."

msgid "This chat is already in the list."
msgstr "Cuộc trò chuyện này đã có trong danh sách."

msgid "This chat is no longer in Recently Deleted."
msgstr "Cuộc trò chuyện này không còn trong Đã xóa gần đây."

msgid "This chat is no longer in the list."
msgstr "Cuộc trò chuyện này không còn trong danh sách."

msgid "This chat's stored history could not be verified. Scene/file changes are disabled to preserve duplicate protection. Readable valid messages and safe observations remain available; start New Chat before making changes."
msgstr "Không xác minh được lịch sử đã lưu của cuộc trò chuyện. Đã tắt thay đổi cảnh/tệp để bảo vệ khỏi thao tác trùng lặp. Vẫn có thể đọc tin nhắn hợp lệ và quan sát an toàn; bắt đầu Cuộc trò chuyện mới trước khi thay đổi."

#. src: angelo_agent/fab_ui.py
msgid "This file exceeds the supported download size."
msgstr "Tệp này vượt quá kích thước tải xuống được hỗ trợ."

#. src: angelo_agent/fab_ui.py
msgid "This file format cannot be added from Fab yet."
msgstr "Chưa thể thêm định dạng tệp này từ Fab."

msgid "This file is managed by the Angelo asset system. It can only be saved as a new, regular file."
msgstr "Tệp này do hệ thống tài nguyên Angelo quản lý. Chỉ có thể lưu thành một tệp thông thường mới."

msgid "This file wasn't allowed: its script is no longer waiting, or the approval couldn't be saved."
msgstr "Chưa cho phép tệp này: tập lệnh của tệp không còn chờ hoặc không lưu được phê duyệt."

msgid "This file's text couldn't be read. Attach a text copy or pictures of its pages instead."
msgstr "Không đọc được văn bản của tệp này. Thay vào đó, hãy đính kèm bản sao văn bản hoặc ảnh các trang."

msgid "This list may be incomplete; check the details below before accepting."
msgstr "Danh sách này có thể chưa đầy đủ; hãy kiểm tra chi tiết bên dưới trước khi chấp nhận."

msgid "This message has as many attachments as it can carry. Send it or remove an attachment to paste the picture."
msgstr "Tin nhắn này đã đủ số tệp đính kèm tối đa. Hãy gửi hoặc gỡ một tệp để dán ảnh."

msgid "This picture is too large to attach ({width} × {height} px). Each side can be at most {limit} px, so paste a smaller picture."
msgstr "Ảnh này quá lớn để đính kèm ({width} × {height} px). Mỗi cạnh tối đa {limit} px; hãy dán ảnh nhỏ hơn."

msgid "This picture is too large to attach: even compressed, it is over {limit} MB. Paste a smaller or cropped picture."
msgstr "Ảnh này quá lớn để đính kèm: ngay cả sau nén vẫn vượt {limit} MB. Hãy dán ảnh nhỏ hơn hoặc đã cắt."

msgid "This preview is no longer available"
msgstr "Bản xem trước này không còn khả dụng"

msgid "This preview is no longer available. Ask Angelo for a new one"
msgstr "Bản xem trước này không còn khả dụng. Hãy yêu cầu Angelo tạo bản mới"

msgid "This preview is not ready yet."
msgstr "Bản xem trước này chưa sẵn sàng."

msgid "This request's delivery is unknown. Wait for its result before trying again."
msgstr "Chưa rõ yêu cầu này đã được gửi đến nơi hay chưa. Hãy đợi kết quả trước khi thử lại."

msgid "This run had already finished, so there was nothing to stop."
msgstr "Lượt chạy này đã kết thúc nên không còn gì để dừng."

msgid "This run's steps can't be changed now: it is no longer waiting for your approval."
msgstr "Không thể thay đổi các bước của lượt chạy này nữa: lượt chạy không còn chờ bạn phê duyệt."

msgid "This step didn't finish. {reason}."
msgstr "Bước này chưa hoàn tất. {reason}."

msgid "This step finished."
msgstr "Bước này đã hoàn tất."

msgid "This step is still running."
msgstr "Bước này vẫn đang chạy."

msgid "This step is waiting for its turn to run."
msgstr "Bước này đang chờ đến lượt chạy."

msgid "This step is waiting for your approval."
msgstr "Bước này đang chờ bạn phê duyệt."

msgid "This step made a preview. Your scene doesn't change until you accept it."
msgstr "Bước này đã tạo bản xem trước. Cảnh của bạn chỉ thay đổi khi bạn chấp nhận."

msgid "This step was stopped."
msgstr "Bước này đã dừng."

msgid "This step's changes were undone."
msgstr "Các thay đổi của bước này đã được hoàn tác."

#. src: angelo_agent/fab_ui.py
msgid "This version is no longer available. Choose another version."
msgstr "Phiên bản này không còn khả dụng. Hãy chọn phiên bản khác."

msgid "Tick the box above to accept."
msgstr "Đánh dấu ô bên trên để chấp nhận."

msgid "Timings Angelo measured (not the model's estimates)"
msgstr "Thời gian do Angelo đo (không phải ước tính của mô hình)"

msgid "Tool"
msgstr "Công cụ"

msgid "Trusted scripts run without asking first and can do anything Angelo can."
msgstr "Tập lệnh đáng tin cậy chạy không hỏi trước và có thể làm mọi thứ Angelo làm được."

msgid "Turn on Global Undo before accepting a preview"
msgstr "Bật Hoàn tác Toàn cục trước khi chấp nhận bản xem trước"

msgid "Turn on Global Undo before accepting scene changes. The changes were not applied"
msgstr "Bật Hoàn tác Toàn cục trước khi chấp nhận thay đổi cảnh. Chưa áp dụng thay đổi"

msgid "Undo"
msgstr "Hoàn tác"

msgid "Undo Steps is 0 in Preferences > System. Set it above 0 first"
msgstr "Số bước hoàn tác đang là 0 trong Tùy chọn > Hệ thống. Hãy đặt lớn hơn 0 trước"

msgid "Updated {object}. You can undo it."
msgstr "Đã cập nhật {object}. Bạn có thể hoàn tác."

msgid "Use These Notes"
msgstr "Dùng các ghi chú này"

msgid "Use the AI providers and library your organization shares"
msgstr "Dùng nhà cung cấp AI và thư viện do tổ chức của bạn chia sẻ"

#. src: angelo_agent/fab_overlay.py
msgid "Use this version"
msgstr "Dùng phiên bản này"

#. :src: angelo_agent/library_approvals.py
msgid "Uses Blender Essentials. Downloads its file only if needed, verifies it and appends the selected asset as one Undo step."
msgstr "Sử dụng Blender Essentials. Chỉ tải tệp khi cần, xác minh tệp và thêm tài nguyên đã chọn trong một bước có thể hoàn tác."

msgid "Uses Blender's own sculpt brushes. Masks and hidden faces are protected. One Undo reverts the pass; Stop takes effect between passes."
msgstr "Dùng cọ điêu khắc của chính Blender. Mặt nạ và các mặt ẩn được bảo vệ. Một lần hoàn tác sẽ hoàn nguyên lượt; Dừng có hiệu lực giữa các lượt."

msgid "Voice isn't available on this computer's system yet."
msgstr "Hệ thống trên máy tính này chưa hỗ trợ giọng nói."

msgid "Voice needs ffmpeg and ffplay installed on this computer. Angelo doesn't download them for you."
msgstr "Giọng nói cần cài ffmpeg và ffplay trên máy tính này. Angelo không tải chúng giúp bạn."

msgid "What Angelo learned about the scene before still has to be checked again."
msgstr "Những gì Angelo từng biết về cảnh vẫn cần được kiểm tra lại."

msgid "Workflow"
msgstr "Quy trình"

msgid "You"
msgstr "Bạn"

msgid "You can turn it off here at any time. Scripts already waiting still ask."
msgstr "Bạn có thể tắt ở đây bất kỳ lúc nào. Các tập lệnh đã chờ vẫn sẽ hỏi."

msgid "You declined this step, so it didn't run."
msgstr "Bạn đã từ chối bước này nên bước đó không chạy."

msgid "Your message was not sent ({why}; support code {code})."
msgstr "Tin nhắn của bạn chưa được gửi ({why}; mã hỗ trợ {code})."

