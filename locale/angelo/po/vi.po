msgstr "Angelo không thể kết xuất cảnh quay này: {reason}"

#. src: angelo_agent/document_identity.py
msgid "Angelo couldn't save this chat. It keeps working, but what happens in it now may be lost if Angelo quits."
msgstr "Angelo không thể lưu cuộc trò chuyện này. Nó vẫn hoạt động, nhưng những gì diễn ra trong đó lúc này có thể mất nếu Angelo đóng."

#. src: angelo_agent/team_token_store.py
msgid "Angelo couldn't save your team sign-in in {store} ({problem}). You're still signed in in this window and Angelo tries again every minute; until then your other Angelo windows wait for it. If {store} is locked, unlock it; if your disk is full, free some space. Keep this window open until it's saved."
msgstr "Angelo không thể lưu đăng nhập nhóm của bạn vào {store} ({problem}). Bạn vẫn đăng nhập trong cửa sổ này và Angelo sẽ thử lại mỗi phút; trong lúc đó các cửa sổ Angelo khác sẽ chờ. Nếu {store} bị khóa, hãy mở khóa; nếu ổ đĩa đầy, hãy giải phóng dung lượng. Hãy giữ cửa sổ này mở cho đến khi lưu xong."

#. src: angelo_agent/worker_ending.py
msgid "Angelo couldn't stop all of this chat's workers after its file changed. Stop them before you merge their parts."
msgstr "Angelo không thể dừng tất cả tác nhân phụ của cuộc trò chuyện này sau khi tệp thay đổi. Hãy dừng chúng trước khi hợp nhất các phần."

#. src: angelo_agent/update_restart.py
msgid "Angelo did not restart"
msgstr "Angelo chưa khởi động lại"

#. src: angelo_agent/job_chat.py
