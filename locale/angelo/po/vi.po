msgstr "Bề mặt làm việc của điểm mốc đã thay đổi; hãy xác định lại"

#. src: angelo_agent/flow_setup.py
msgid "The last attempt failed. Running it again starts a new paid generation."
msgstr "Lần thử gần nhất đã thất bại. Chạy lại sẽ bắt đầu một lần sinh tạo mới có tính phí."

#. src: angelo_agent/updates_prefs.py
msgid "The last check could not reach the update server."
msgstr "Lần kiểm tra gần nhất không thể kết nối tới máy chủ cập nhật."

#. src: angelo_agent/crash_card.py
msgid "The last crash report Angelo sent"
msgstr "Báo cáo sự cố gần nhất Angelo đã gửi"

#. :src: scripts/addons_core/angelo_agent/web_preview.py
#. src: angelo_agent/web_preview.py
msgid "The last export failed; showing the one before it"
msgstr "Lần xuất gần nhất thất bại; đang hiển thị lần trước đó"

#. src: source/blender/render/intern/angelo_region_render.cc
msgid "The last render has no pixels to render over"
msgstr "Lần kết xuất trước không có điểm ảnh để kết xuất đè lên"

