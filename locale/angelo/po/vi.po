msgstr "Angelo chưa trả lại các sắp đặt này: {names}"

#. src: angelo_agent/job_bake_maps.py
msgid "Angelo ended a bake of the texture set without writing it; see its Info log"
msgstr "Angelo đã kết thúc một lượt nướng bộ texture mà không ghi ra; xem nhật ký Info của nó"

