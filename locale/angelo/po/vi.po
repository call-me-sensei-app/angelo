#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "Angelo works across Blender: modeling, modifiers, materials and node trees, sculpting, cameras and lights, keyframes, the NLA editor, markers, bones, constraints and particles."
msgstr "Angelo làm việc trên khắp Blender: tạo mô hình, bộ điều chỉnh, nguyên vật liệu và cây nút, điêu khắc, máy quay phim và đèn, khung khóa, trình biên soạn NLA, điểm đánh dấu, xương, ràng buộc và hạt."

#. src: angelo_agent/approvals.py
msgid "Angelo works on a copy, checks that your scene hasn't changed, then applies everything as one Undo step. Stop cancels between steps."
msgstr "Angelo làm việc trên một bản sao, kiểm tra rằng cảnh của bạn chưa thay đổi, rồi áp dụng mọi thứ thành một bước Hoàn Tác. Dừng sẽ hủy giữa các bước."

#. src: angelo_agent/job_runners.py
