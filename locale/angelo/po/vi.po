#. src: angelo_agent/fab_overlay.py
msgid "License: {license}"
msgstr "Giấy phép: {license}"

msgid "Limits are applied automatically after each snapshot: the oldest snapshots go first. Active requests in every chat, safety snapshots and required file-restore chains are kept, even if that leaves storage over the limit. A removed snapshot keeps its Restore link, shown as unavailable. Snapshots captured before a git commit identical to the saved project are removed first."
msgstr "Giới hạn tự động áp dụng sau mỗi bản chụp nhanh: bản cũ nhất được gỡ trước. Yêu cầu đang hoạt động trong mọi cuộc trò chuyện, bản chụp nhanh an toàn và chuỗi khôi phục tệp cần thiết được giữ lại, kể cả khi vượt giới hạn lưu trữ. Bản đã gỡ vẫn giữ liên kết Khôi phục nhưng hiển thị không khả dụng. Ưu tiên gỡ bản được chụp trước bản ghi git giống với dự án đã lưu."

#. :src: angelo_agent/library_approvals.py
msgid "Loads the asset into this file without connecting nodes or activating a brush."
msgstr "Nạp tài nguyên vào tệp này mà không kết nối nút hoặc kích hoạt cọ."

msgid "Local CLI client '{label}'. Phase 1 is read-only: observations only; no scene, file, memory, billing or provider changes. Approvals and Stop only. Rotated from chat {previous} by `angelo session new`."
msgstr "Máy khách CLI cục bộ '{label}'. Giai đoạn 1 chỉ đọc: chỉ quan sát; không thay đổi cảnh, tệp, bộ nhớ, thanh toán hoặc nhà cung cấp. Chỉ phê duyệt và Dừng. Chuyển từ cuộc trò chuyện {previous} bằng `angelo session new`."

msgid "Media Studio couldn't open here. Try again in a moment."
msgstr "Không mở được Media Studio ở đây. Hãy thử lại sau giây lát."

msgid "Minimize the Sessions panel. Press {key} to use the panel from the keyboard."
msgstr "Thu nhỏ bảng Phiên. Nhấn {key} để dùng bảng bằng bàn phím."

msgid "Moved “{title}” to Recently Deleted."
msgstr "Đã chuyển “{title}” vào Đã xóa gần đây."

