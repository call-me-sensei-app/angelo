msgstr "Kho bản chụp nhanh không hoàn tất được tác vụ: {error}. Các bản hiện có vẫn khả dụng."

msgid "Snapshot storage could not finish its cleanup: {error}. Existing snapshots stay available."
msgstr "Kho bản chụp nhanh không dọn dẹp xong: {error}. Các bản hiện có vẫn khả dụng."

msgid "Snapshot storage could not finish packing a new snapshot: {error}. Existing snapshots stay available."
msgstr "Kho bản chụp nhanh không đóng gói xong bản mới: {error}. Các bản hiện có vẫn khả dụng."

msgid "Snapshots remain over the limit ({limits}) because one snapshot is protected: an active request, a safety snapshot or a file restore still needs it."
msgstr "Bản chụp nhanh vẫn vượt giới hạn ({limits}) vì một bản được bảo vệ: yêu cầu đang hoạt động, bản chụp nhanh an toàn hoặc khôi phục tệp vẫn cần nó."

msgid "Snapshots remain over the limit ({limits}) because {count} snapshots are protected: active requests, safety snapshots or file restores still need them."
msgstr "Bản chụp nhanh vẫn vượt giới hạn ({limits}) vì {count} bản được bảo vệ: yêu cầu đang hoạt động, bản chụp nhanh an toàn hoặc khôi phục tệp vẫn cần chúng."

msgid "Snapshots save your scene before larger changes, and you can return to any of them."
msgstr "Bản chụp nhanh lưu cảnh trước các thay đổi lớn và bạn có thể quay lại bất kỳ bản nào."

msgid "Starting point"
msgstr "Điểm bắt đầu"

msgid "Stop can't interrupt a script once it is running."
msgstr "Dừng không thể ngắt tập lệnh sau khi đã chạy."

msgid "Stop requested. A running script can't be interrupted. The provider may still finish the work already sent and charge for it."
msgstr "Đã yêu cầu dừng. Không thể ngắt tập lệnh đang chạy. Nhà cung cấp vẫn có thể hoàn tất công việc đã gửi và tính phí."

msgid "Stop sending automatically"
msgstr "Dừng gửi tự động"

msgid "Stop trusting scripts"
msgstr "Ngừng tin cậy tập lệnh"

msgid "Stop voice to send this message again."
msgstr "Dừng giọng nói để gửi lại tin nhắn này."

msgid "Stopped watching"
msgstr "Đã ngừng theo dõi"

msgid "Stopped watching. The provider may still finish the work already sent and charge for it."
msgstr "Đã ngừng theo dõi. Nhà cung cấp vẫn có thể hoàn tất công việc đã gửi và tính phí."

msgid "Stopping between steps. The provider may still finish the work already sent and charge for it; changes already applied can still be undone."
msgstr "Đang dừng giữa các bước. Nhà cung cấp vẫn có thể hoàn tất công việc đã gửi và tính phí; vẫn hoàn tác được thay đổi đã áp dụng."

msgid "Stopping. Previews are not applied to your scene; work in progress stops between steps. The provider may still finish the work already sent and charge for it."
msgstr "Đang dừng. Bản xem trước chưa áp dụng vào cảnh; công việc đang chạy dừng giữa các bước. Nhà cung cấp vẫn có thể hoàn tất công việc đã gửi và tính phí."

#. src: angelo_agent/fab_settings.py
msgid "Suggest paid assets"
msgstr "Đề xuất tài nguyên trả phí"

msgid "Talk with the agent by voice"
msgstr "Trò chuyện với tác tử bằng giọng nói"

