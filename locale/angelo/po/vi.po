#. src: angelo_agent/job_fluid.py
msgid "The disk would have filled before the bake ended, so it was stopped; free some space or lower the domain's resolution or frame range"
msgstr "Đĩa sẽ đầy trước khi nướng xong, nên đã dừng; hãy giải phóng dung lượng hoặc giảm độ phân giải hay khoảng khung hình của miền"

#. src: angelo_agent/agent_workspace_ui.py
msgid "The document changed during brief editing; reopen Project Brief"
msgstr "Tài liệu đã thay đổi trong lúc biên soạn bản tóm tắt; hãy mở lại Tóm tắt dự án"

#. src: angelo_agent/project_brief_rebind_ui.py
msgid "The document changed during review; reopen the public-brief confirmation"
msgstr "Tài liệu đã thay đổi trong lúc xem xét; hãy mở lại phần xác nhận bản tóm tắt công khai"

#. src: angelo_agent/controller.py
msgid "The document changed; start a new chat"
msgstr "Tài liệu đã thay đổi; hãy bắt đầu một cuộc trò chuyện mới"

#. src: angelo_agent/job_chat.py
msgid "The document closed during the render"
msgstr "Tài liệu đã đóng trong khi kết xuất"

#. src: angelo_agent/job_recovery.py
msgid "The document was closed or reloaded, which stopped this render. The frames that finished are kept; each is a whole frame."
msgstr "Tài liệu đã bị đóng hoặc tải lại, việc này làm dừng lần kết xuất này. Các khung hình đã hoàn tất được giữ lại; mỗi khung hình đều trọn vẹn."

#. src: angelo_agent/job_manager.py
msgid "The document was closed or reloaded, which stops Angelo's jobs. Nothing was published."
msgstr "Tài liệu đã bị đóng hoặc tải lại, việc này làm dừng các tác vụ của Angelo. Không có kết quả nào được lưu."

#. src: angelo_agent/job_approvals.py
msgid "The domain has no cache folder of its own; this bake gives it one in the output."
msgstr "Miền không có thư mục bộ nhớ đệm riêng; lần nướng này tạo cho nó một thư mục trong đầu ra."

#. src: angelo_agent/job_approvals.py
msgid "The domain's earlier cache stays on disk, no longer used once this bake finishes."
msgstr "Bộ nhớ đệm trước đó của miền vẫn nằm trên đĩa và không còn được dùng sau khi lần nướng này xong."

#. src: source/blender/modifiers/intern/MOD_tension.cc
msgid "The edge attribute needs its own name that is not built in"
msgstr "Thuộc tính cạnh cần tên riêng không phải tên có sẵn"

#. src: angelo_agent/engine_link_ui.py
msgid "The engine live link couldn't start: {reason}"
msgstr "Không thể bắt đầu liên kết trực tiếp với engine: {reason}"

#. src: angelo_agent/engine_link_ui.py
msgid "The engine live link is off"
msgstr "Liên kết trực tiếp với engine đang tắt"

#. src: angelo_agent/engine_link_ui.py
msgid "The engine live link is on. In Godot, Unity or Unreal Engine, use Edit in Angelo on a model"
msgstr "Liên kết trực tiếp với engine đang bật. Trong Godot, Unity hoặc Unreal Engine, dùng Edit in Angelo trên một mô hình"

#. src: angelo_agent/studio_enhance.py
msgid "The enhancer returned no prompt. Your original prompt is unchanged."
msgstr "Bộ tăng cường không trả về lời nhắc nào. Lời nhắc gốc của bạn không thay đổi."

#. src: angelo_agent/studio_generation.py
msgid "The enhancer returned no prompt; your original prompt has not changed"
msgstr "Bộ tăng cường không trả về lời nhắc nào; lời nhắc gốc của bạn không thay đổi"

#. src: bpy.types.AngeloPhysicsSettings.shape:'TRIMESH'
msgid "The exact mesh: for static level geometry only, slowest to collide"
msgstr "Khung lưới chính xác: chỉ dành cho hình học màn chơi tĩnh, va đập chậm nhất"

#. src: angelo_agent/agent_workspace_ui.py
msgid "The exact preview approval expired; no change was applied"
msgstr "Phê duyệt cho bản xem trước chính xác đã hết hạn; không có thay đổi nào được áp dụng"

#. src: angelo_agent/checkpoint_review_ui.py
msgid "The exact request/edit boundary was not recorded. No before-message boundary is promised."
msgstr "Ranh giới chính xác giữa yêu cầu/chỉnh sửa không được ghi lại. Không đảm bảo có ranh giới trước tin nhắn."

#. src: angelo_agent/job_exports.py
#. src: angelo_agent/job_runners.py
msgid "The exported USD references files that don't exist; nothing was published"
msgstr "Tập tin USD đã xuất tham chiếu đến các tập tin không tồn tại; không có kết quả nào được lưu"

#. src: angelo_agent/job_recovery.py
#. src: angelo_agent/job_resume.py
msgid "The file this render came from was never saved, so its scene can't be rendered again"
msgstr "Tập tin gốc của lần kết xuất này chưa từng được lưu, nên không thể kết xuất lại cảnh của nó"

#. src: angelo_agent/job_recovery.py
#. src: angelo_agent/job_runners.py
msgid "The finished frames couldn't be published; they are kept for the next start"
msgstr "Không thể xuất bản các khung hình đã hoàn tất; chúng được giữ lại cho lần khởi động tới"

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The first time a view shows one object with many new materials, or a new world, the window can still pause briefly while their shaders are set up. More of this moves to the background in 1.1."
msgstr "Lần đầu một khung nhìn hiển thị một đối tượng có nhiều vật liệu mới, hoặc một thế giới mới, cửa sổ vẫn có thể khựng lại một chút trong khi shader của chúng được chuẩn bị. Phần lớn hơn của việc này sẽ chuyển sang chế độ nền trong 1.1."

#. src: angelo_agent/studio_workflow_ops.py
msgid "The fit belongs to a sheet that was split again; fit the parts again"
msgstr "Kết quả khớp này thuộc về một bảng đã được tách lại; hãy khớp lại các bộ phận"

#. src: angelo_agent/flow_ui.py
msgid "The flow changed while this dialog was open; nothing ran. Run it again to review the new plan"
msgstr "Luồng đã thay đổi trong khi hộp thoại này đang mở; không có gì được chạy. Hãy chạy lại để xem xét kế hoạch mới"

#. src: angelo_agent/flow_open.py
msgid "The flow couldn't open a window here"
msgstr "Luồng không mở được cửa sổ ở đây"

#. src: angelo_agent/job_recovery.py
msgid "The folder this render's finished frames were moved into is gone or was renamed; the rest it wrote is kept in its hidden folder beside the output."
msgstr "Thư mục chứa các khung hình đã xong của lần kết xuất này đã không còn hoặc bị đổi tên; phần còn lại được giữ trong thư mục ẩn bên cạnh đầu ra."

#. src: angelo_agent/job_recovery.py
msgid "The frames that finished are kept in the job's hidden folder, but some of its files couldn't be read now, so nothing was published yet. Angelo tries again when it next starts."
msgstr "Các khung hình đã hoàn tất được giữ trong thư mục ẩn của tác vụ, nhưng hiện không thể đọc một số tệp trong đó, nên chưa có gì được xuất bản. Angelo sẽ thử lại vào lần khởi động tới."

#. src: angelo_agent/job_recovery.py
msgid "The frames that finished are kept in the job's hidden folder, which can't be reached now (a drive that is not connected, or a folder that was moved). Angelo tries again when it next starts."
msgstr "Các khung hình đã hoàn tất được giữ trong thư mục ẩn của tác vụ, hiện không thể truy cập (ổ đĩa chưa được kết nối, hoặc thư mục đã bị di chuyển). Angelo sẽ thử lại vào lần khởi động tới."

#. src: angelo_agent/job_recovery.py
msgid "The frames that finished are kept, but they couldn't be published yet (the disk may be full). Angelo tries again when it next starts."
msgstr "Các khung hình đã hoàn tất được giữ lại, nhưng chưa thể xuất bản (ổ đĩa có thể đã đầy). Angelo sẽ thử lại vào lần khởi động tới."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The free Angelo Library, powered by ToonLab: models, texture sets, HDRIs and VFX, one click from the 3D view."
msgstr "Thư viện Angelo miễn phí, được ToonLab hỗ trợ: mô hình, bộ texture, HDRI và VFX, cách khung nhìn 3D một cú nhấp."

#. src: angelo_agent/project_brief_rebind_ui.py
