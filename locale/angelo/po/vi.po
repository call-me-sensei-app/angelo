msgstr "Nút đó hiện không thực hiện được thao tác. Hãy thử lại sau giây lát."

msgid "That didn't work because of an unexpected problem. The details are in the system console."
msgstr "Không thực hiện được do sự cố ngoài dự kiến. Chi tiết có trong bảng điều khiển hệ thống."

msgid "That image couldn't be attached. It may not be ready yet, or the message already holds as many files as it can."
msgstr "Không đính kèm được ảnh đó. Ảnh có thể chưa sẵn sàng hoặc tin nhắn đã đủ số tệp tối đa."

msgid "That result couldn't be chosen for its step. The flow may have changed since it ran."
msgstr "Không chọn được kết quả đó cho bước tương ứng. Luồng có thể đã thay đổi kể từ khi chạy."

msgid "The Blender Python script finished."
msgstr "Tập lệnh Python của Blender đã hoàn tất."

#. src: angelo_agent/fab_ui.py
msgid "The Fab account changed. Search and choose the asset again."
msgstr "Tài khoản Fab đã thay đổi. Hãy tìm kiếm và chọn lại tài sản."

#. src: angelo_agent/fab_ui.py
msgid "The Fab action stopped."
msgstr "Thao tác Fab đã dừng."

#. src: angelo_agent/fab_ui.py
msgid "The Fab asset couldn't be added. Check the scene before trying again."
msgstr "Không thể thêm tài sản Fab. Hãy kiểm tra cảnh trước khi thử lại."

#. src: angelo_agent/fab_ui.py
msgid "The Fab connection is not ready."
msgstr "Kết nối Fab chưa sẵn sàng."

#. src: angelo_agent/fab_ui.py
msgid "The Fab download couldn't be stored on this computer."
msgstr "Không thể lưu nội dung tải xuống từ Fab trên máy tính này."

#. src: angelo_agent/fab_ui.py
msgid "The Fab download failed. Try again."
msgstr "Tải xuống từ Fab không thành công. Hãy thử lại."

msgid "The agent keeps sight of what an edit did to the World, motion and shared data in long chats, instead of losing those facts when older results are shortened."
msgstr "Tác tử ghi nhớ tác động của chỉnh sửa đến Thế giới, chuyển động và dữ liệu dùng chung trong cuộc trò chuyện dài, thay vì mất các dữ kiện đó khi rút gọn kết quả cũ."

msgid "The camera move video (MP4) wasn't made for this shot: {reason}"
msgstr "Chưa tạo được video chuyển động máy quay (MP4) cho cảnh quay này: {reason}"

msgid "The changes were not applied: {reason}."
msgstr "Chưa áp dụng thay đổi: {reason}."

msgid "The disk is full. Free some space and try again."
msgstr "Đĩa đã đầy. Hãy giải phóng dung lượng rồi thử lại."

msgid "The disk is read-only, so nothing could be saved there."
msgstr "Đĩa chỉ đọc nên không lưu được gì vào đó."

msgid "The document changed during the review; the preview was not applied"
msgstr "Tài liệu đã thay đổi trong lúc xem xét; chưa áp dụng bản xem trước"

msgid "The file changed while you were editing the brief. Open Project Brief again"
msgstr "Tệp đã thay đổi trong lúc bạn sửa bản tóm tắt. Hãy mở lại Tóm tắt dự án"

msgid "The file changed while you were reviewing. Open the notes again"
msgstr "Tệp đã thay đổi trong lúc bạn xem xét. Hãy mở lại ghi chú"

msgid "The file this job made couldn't be opened. It may have been moved or deleted."
msgstr "Không mở được tệp do tác vụ này tạo. Tệp có thể đã bị di chuyển hoặc xóa."

msgid "The first frame wasn't made for this shot: {reason}"
msgstr "Chưa tạo được khung hình đầu cho cảnh quay này: {reason}"

msgid "The key Angelo uses to check snapshots was damaged, so Angelo started a new one. Snapshots taken before now can't be restored; new snapshots can."
msgstr "Khóa Angelo dùng để kiểm tra bản chụp nhanh bị hỏng nên Angelo đã tạo khóa mới. Không thể khôi phục các bản chụp nhanh trước thời điểm này; bản mới thì có thể."

msgid "The key Angelo uses to check snapshots was missing or damaged, so Angelo wrote it again from its own copy. Every snapshot can still be restored."
msgstr "Khóa Angelo dùng để kiểm tra bản chụp nhanh bị thiếu hoặc hỏng nên Angelo đã ghi lại từ bản sao riêng. Vẫn có thể khôi phục mọi bản chụp nhanh."

msgid "The key Angelo uses to check snapshots was missing, so Angelo started a new one. Snapshots taken before now can't be restored; new snapshots can."
msgstr "Khóa Angelo dùng để kiểm tra bản chụp nhanh bị thiếu nên Angelo đã tạo khóa mới. Không thể khôi phục các bản chụp nhanh trước thời điểm này; bản mới thì có thể."

msgid "The last frame wasn't made for this shot: {reason}"
msgstr "Chưa tạo được khung hình cuối cho cảnh quay này: {reason}"

msgid "The library item couldn't be added to the scene."
msgstr "Không thêm được mục thư viện vào cảnh."

msgid "The library item couldn't be prepared. Try adding it again."
msgstr "Không chuẩn bị được mục thư viện. Hãy thử thêm lại."

#. src: angelo_agent/fab_ui.py
msgid "The license has not been confirmed."
msgstr "Giấy phép chưa được xác nhận."

msgid "The missing frames weren't rendered. Check the job's card, then try again."
msgstr "Chưa kết xuất các khung hình còn thiếu. Hãy kiểm tra thẻ tác vụ rồi thử lại."

msgid "The model contained no objects, so nothing was placed"
msgstr "Mô hình không chứa đối tượng nên không đặt gì vào cảnh"

msgid "The notes are in this chat but could not be saved: {error} Nothing was approved."
msgstr "Ghi chú có trong cuộc trò chuyện nhưng không lưu được: {error} Chưa phê duyệt gì."

msgid "The notes changed while you were reviewing. Read them again before confirming"
msgstr "Ghi chú đã thay đổi trong lúc bạn xem xét. Hãy đọc lại trước khi xác nhận"

