msgid "Settings"
msgstr "Thiết lập"

msgid "Shadow color"
msgstr "Màu bóng"

#. src: angelo_agent/fab_ui.py
msgid "Sign in to Fab in the browser, then return here."
msgstr "Đăng nhập Fab trong trình duyệt, rồi quay lại đây."

msgid "Signed in to {org}"
msgstr "Đã đăng nhập vào {org}"

msgid "Sizes, references and assets"
msgstr "Kích thước, tư liệu tham khảo và tài nguyên"

msgid "Snapshot limit applied: removed one snapshot ({size}), captured before the project's latest git commit. Its Restore link now shows as unavailable; limits are in Snapshot Settings."
msgstr "Đã áp dụng giới hạn: gỡ một bản chụp nhanh ({size}) được chụp trước bản ghi git mới nhất của dự án. Liên kết Khôi phục nay không khả dụng; giới hạn ở Thiết lập Bản chụp nhanh."

msgid "Snapshot limit applied: removed the oldest snapshot ({size}). Its Restore link now shows as unavailable; limits are in Snapshot Settings."
msgstr "Đã áp dụng giới hạn: gỡ bản chụp nhanh cũ nhất ({size}). Liên kết Khôi phục nay không khả dụng; giới hạn ở Thiết lập Bản chụp nhanh."

msgid "Snapshot limit applied: removed the {count} oldest snapshots ({size}). Their Restore links now show as unavailable; limits are in Snapshot Settings."
msgstr "Đã áp dụng giới hạn: gỡ {count} bản chụp nhanh cũ nhất ({size}). Các liên kết Khôi phục nay không khả dụng; giới hạn ở Thiết lập Bản chụp nhanh."

msgid "Snapshot limit applied: removed {count} snapshots ({size}), first those captured before the project's latest git commit. Their Restore links now show as unavailable; limits are in Snapshot Settings."
msgstr "Đã áp dụng giới hạn: gỡ {count} bản chụp nhanh ({size}), ưu tiên các bản trước bản ghi git mới nhất của dự án. Các liên kết Khôi phục nay không khả dụng; giới hạn ở Thiết lập Bản chụp nhanh."

msgid "Snapshot settings…"
msgstr "Thiết lập bản chụp nhanh…"

