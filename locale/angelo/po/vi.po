msgid "The last render is %d x %d pixels and this one is %d x %d; render the full frame first"
msgstr "Lần kết xuất trước là %d x %d điểm ảnh còn lần này là %d x %d; hãy kết xuất toàn khung hình trước"

#. src: angelo_agent/render_region_card.py
msgid "The last render is kept exactly as it was."
msgstr "Lần kết xuất trước được giữ nguyên hoàn toàn."

#. src: bpy.types.RenderSettings.angelo_region_render:'NONE'
msgid "The last render was not a region render over the render before it"
msgstr "Lần kết xuất trước không phải là bản kết xuất vùng đè lên lần trước đó"

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The lead's tile in the Sessions panel keeps its picture while you look at another scene, and shows the scene camera or your view only when the model fills the frame; otherwise it frames the model."
msgstr "Ô của cuộc trò chuyện chính trong bảng phiên giữ nguyên hình ảnh khi bạn xem cảnh khác, và chỉ hiển thị camera của cảnh hoặc góc nhìn của bạn khi mô hình lấp đầy khung hình; nếu không, ô sẽ đóng khung mô hình."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The lead's window no longer freezes for seconds when a view first shows new materials: their shaders compile in the background."
msgstr "Cửa sổ của cuộc trò chuyện chính không còn bị đơ vài giây khi một khung nhìn lần đầu hiển thị vật liệu mới: shader của chúng được biên dịch ở chế độ nền."

#. src: angelo_agent/library_overlay_draw.py
msgid "The library is offline. Check your network and try again."
msgstr "Thư viện đang ngoại tuyến. Hãy kiểm tra mạng và thử lại."

#. src: angelo_agent/studio_library_ops.py
msgid "The library is on again, so nothing was deleted"
msgstr "Thư viện đã bật lại nên không có gì bị xóa"

#. src: bpy.types.SpaceFileBrowser.angelo_list_ready
msgid "The list is fully read and filtered, so its counts are final for what is shown"
msgstr "Danh sách đã được đọc và lọc xong hoàn toàn, nên số đếm là cuối cùng cho những gì đang hiện"

#. src: angelo_agent/engine_link_ui.py
msgid "The live link is on for {project}, and the npm install command is on the clipboard. Then add angeloLive() from @call-me-sensei/angelo/vite to the plugins in its Vite config"
msgstr "Liên kết trực tiếp đã bật cho {project} và lệnh cài đặt npm đã nằm trong bảng nhớ tạm. Sau đó, thêm angeloLive() từ @call-me-sensei/angelo/vite vào các plugin trong cấu hình Vite của dự án"

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The live web preview no longer ends Edit Mode after each pause: it waits while you edit, and Sculpt and the paint modes keep their mode."
msgstr "Bản xem trước web trực tiếp không còn thoát Chế Độ Biên Soạn sau mỗi lần dừng: nó chờ khi bạn chỉnh sửa, còn Điêu Khắc và các chế độ tô vẽ giữ nguyên chế độ."

#. src: angelo_agent/studio_state.py
msgid "The local asset is missing or invalid"
msgstr "Tài sản cục bộ bị thiếu hoặc không hợp lệ"

#. src: angelo_agent/settings_import_card.py
msgid "The log has the details. If anything changed, Undo Settings Import in File > Defaults puts it back."
msgstr "Nhật ký có thông tin chi tiết. Nếu có gì đã thay đổi, “Hoàn tác nhập cài đặt” trong Tập Tin > Mặc Định sẽ đưa mọi thứ về như cũ."

#. src: scripts/addons_core/angelo_agent/assets/release_notes.json
msgid "The look is saved in the .glb file's scene data, so your own Three.js page can apply the same tone mapping, exposure and environment."
msgstr "Diện mạo được lưu trong dữ liệu cảnh của tệp .glb, nên trang Three.js của riêng bạn có thể áp dụng cùng ánh xạ tông màu, độ phơi sáng và môi trường."

#. src: source/blender/makesrna/intern/rna_modifier.cc
msgid "The mesh before shape keys and modifiers"
msgstr "Khung lưới trước hình mẫu và bộ điều chỉnh"

#. src: bpy.types.AngeloPhysicsSettings.shape:'CONVEX'
msgid "The mesh's convex hull: fast and fits most props"
msgstr "Bao lồi của khung lưới: nhanh và vừa với hầu hết đạo cụ"

#. src: angelo_agent/live_progress.py
msgid "The model is working without sharing its thoughts. Large requests can take a few minutes."
msgstr "Mô hình đang làm việc mà không chia sẻ suy nghĩ. Yêu cầu lớn có thể mất vài phút."

