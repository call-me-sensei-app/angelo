msgstr "le chat n’est pas ouvert dans son auxiliaire"

#. src: angelo_agent/worker_reasons.py
msgid "the chat is set to Read only"
msgstr "le chat est en « Lecture seule »"

#. src: angelo_agent/chat_start_states.py
