msgid "This version is no longer available. Choose another version."
msgstr "Cette version n’est plus disponible. Sélectionnez une autre version."

msgid "Tick the box above to accept."
msgstr "Cochez la case ci-dessus pour accepter."

msgid "Timings Angelo measured (not the model's estimates)"
msgstr "Durées mesurées par Angelo (pas des estimations du modèle)"

msgid "Tool"
msgstr "Outil"

