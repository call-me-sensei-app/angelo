#. src: angelo_agent/job_chat.py
msgid "Angelo closed during the render"
msgstr "Angelo a été fermé pendant le rendu"

#. src: angelo_agent/job_recovery.py
msgid "Angelo closed while this render ran, before any frame finished. Nothing was published."
msgstr "Angelo a été fermé pendant ce rendu, avant qu’une frame soit terminée. Rien n’a été livré."

#. src: angelo_agent/job_recovery.py
msgid "Angelo closed while this render ran. Its files were left as they were in the job's hidden folder beside the output, because this version can't tell which of them are whole frames."
msgstr "Angelo a été fermé pendant ce rendu. Ses fichiers ont été laissés tels quels dans le dossier masqué de la tâche, à côté de la sortie, car cette version ne peut pas savoir lesquels sont des frames complètes."

#. src: angelo_agent/job_recovery.py
msgid "Angelo closed while this render ran. The frames that finished are kept; each is a whole frame."
msgstr "Angelo a été fermé pendant ce rendu. Les frames terminées sont conservées ; chacune est une frame complète."

#. src: angelo_agent/job_runners.py
msgid "Blender stopped while writing a frame (the disk may be full); that frame was not kept"
msgstr "Blender s’est arrêté pendant l’écriture d’une frame (le disque est peut-être plein) ; cette frame n’a pas été conservée"

#. src: angelo_agent/job_runners.py
msgid "Blender wrote an incomplete image (the disk may be full); nothing was published"
msgstr "Blender a écrit une image incomplète (le disque est peut-être plein) ; rien n’a été livré"

