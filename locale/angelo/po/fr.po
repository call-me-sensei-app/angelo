msgstr "La console Angelo a renvoyé une clé d’agent de code non valide."

#. src: angelo_agent/team_errors.py
msgid "The Angelo gateway doesn't offer this operation."
msgstr "La passerelle Angelo ne prend pas en charge cette opération."

#. src: angelo_agent/team_errors.py
msgid "The Angelo gateway doesn't offer this {provider} operation."
msgstr "La passerelle Angelo ne prend pas en charge cette opération {provider}."

#. src: angelo_agent/team_errors.py
