{
  "name": "@call-me-sensei/angelo",
  "version": "0.1.1",
  "description": "Angelo's web live link: see Angelo's edits live in your own Three.js page, through your Vite dev server.",
  "license": "MIT",
  "author": "Hyperbond Studio Pte. Ltd.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "development": "./src/browser/index.js",
      "production": "./src/stub.js",
      "default": "./src/stub.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "PROTOCOL.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "three": ">=0.172.0",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.187.0",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest run"
  },
  "keywords": ["three", "threejs", "vite", "vite-plugin", "gltf", "live-link", "angelo"]
}
